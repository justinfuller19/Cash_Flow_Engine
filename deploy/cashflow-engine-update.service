[Unit]
Description=CashFlow Engine application updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/cashflow-engine
EnvironmentFile=-/etc/cashflow-engine.env
ExecStart=/opt/cashflow-engine/scripts/update_application.sh
TimeoutStartSec=900
