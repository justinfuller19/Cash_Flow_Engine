[Unit]
Description=CashFlow Engine weekly household cash-flow email
After=network.target

[Service]
Type=oneshot
User=cashflow
Group=cashflow
WorkingDirectory=/opt/cashflow-engine
EnvironmentFile=-/etc/cashflow-engine.env
ExecStart=/opt/cashflow-engine/.venv/bin/python /opt/cashflow-engine/scripts/send_email_reports.py --mode weekly
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cashflow-engine /var/backups/cashflow-engine
